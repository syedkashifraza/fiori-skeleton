{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Leave Tracker (mock, member)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["fiori", "run"],
      "args": ["--config", "./ui5-mock.yaml", "--open", "index.html"],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "env": { "FIORI_TOOLS_URL_PARAMS": "sap-ui-xx-viewCache=false" }
    },
    {
      "name": "Start Leave Tracker (mock, manager)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "windows": { "runtimeExecutable": "npx.cmd" },
      "runtimeArgs": ["fiori", "run"],
      "args": ["--config", "./ui5-mock.yaml", "--open", "index.html?role=manager"],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "env": { "FIORI_TOOLS_URL_PARAMS": "sap-ui-xx-viewCache=false" }
    }
  ]
}
