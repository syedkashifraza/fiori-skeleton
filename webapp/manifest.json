{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.team.leavetracker",
    "type": "application",
    "i18n": {
      "bundleName": "com.team.leavetracker.i18n.i18n",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/leave/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/mainService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "leavetracker-display": {
          "semanticObject": "LeaveTracker",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icon": "sap-icon://general-leave-request",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.team.leavetracker.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "rootView": {
      "viewName": "com.team.leavetracker.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "com.team.leavetracker.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true,
        "bypassed": {
          "target": "home"
        }
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": "home"
        },
        {
          "name": "calendar",
          "pattern": "calendar",
          "target": "calendar"
        },
        {
          "name": "availability",
          "pattern": "availability/:date:",
          "target": "availability"
        },
        {
          "name": "myLeaves",
          "pattern": "myLeaves",
          "target": "myLeaves"
        },
        {
          "name": "leaveDetail",
          "pattern": "myLeaves/{id}",
          "target": "leaveDetail"
        },
        {
          "name": "approvals",
          "pattern": "approvals",
          "target": "approvals"
        },
        {
          "name": "approvalDetail",
          "pattern": "approvals/{id}",
          "target": "approvals"
        },
        {
          "name": "team",
          "pattern": "team",
          "target": "team"
        },
        {
          "name": "rules",
          "pattern": "rules",
          "target": "rules"
        },
        {
          "name": "ruleDetail",
          "pattern": "rules/{id}",
          "target": "rules"
        },
        {
          "name": "periods",
          "pattern": "periods",
          "target": "periods"
        }
      ],
      "targets": {
        "home": {
          "id": "home",
          "name": "Home",
          "level": 1
        },
        "calendar": {
          "id": "calendar",
          "name": "Calendar",
          "level": 1
        },
        "availability": {
          "id": "availability",
          "name": "Availability",
          "level": 1
        },
        "myLeaves": {
          "id": "myLeaves",
          "name": "MyLeaves",
          "level": 1
        },
        "leaveDetail": {
          "id": "leaveDetail",
          "name": "LeaveDetail",
          "level": 2
        },
        "approvals": {
          "id": "approvals",
          "name": "Approvals",
          "level": 1
        },
        "team": {
          "id": "team",
          "name": "Team",
          "level": 1
        },
        "rules": {
          "id": "rules",
          "name": "Rules",
          "level": 1
        },
        "periods": {
          "id": "periods",
          "name": "Periods",
          "level": 1
        }
      }
    }
  }
}
