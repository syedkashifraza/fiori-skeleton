<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog id="leaveRequestDialog" title="{i18n>request.title}" contentWidth="34rem" busy="{req>/busy}"
    afterClose=".onRequestDialogAfterClose">
    <content>
      <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
        <Label text="{i18n>leave.type}" required="true"/>
        <Select selectedKey="{req>/typeCode}" items="{path: 'req>/types', templateShareable: false}" width="100%">
          <core:Item key="{req>code}" text="{req>name}"/>
        </Select>

        <Label text="{i18n>leave.period}" required="true"/>
        <DateRangeSelection
          dateValue="{req>/start}"
          secondDateValue="{req>/end}"
          minDate="{req>/minDate}"
          valueState="{req>/dateState}"
          valueStateText="{i18n>request.dateRequired}"
          change=".onRequestChange"/>

        <Label text="{i18n>request.halfDays}"/>
        <CheckBox text="{i18n>request.startHalf}" selected="{req>/startHalfDay}" select=".onRequestChange"/>
        <CheckBox text="{i18n>request.endHalf}" selected="{req>/endHalfDay}" select=".onRequestChange"/>

        <Label text="{i18n>leave.workingDays}"/>
        <ObjectNumber number="{req>/workingDays}" unit="{i18n>leave.days}"/>

        <Label text="{i18n>leave.comment}"/>
        <TextArea value="{req>/comment}" rows="3" maxLength="500" width="100%"/>
      </f:SimpleForm>

      <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
        <MessageStrip text="{req>/othersOutText}" type="{= ${req>/othersOut} > 0 ? 'Warning' : 'Success' }"
          showIcon="true" visible="{= !!${req>/othersOutText} }" class="sapUiTinyMarginBottom"/>
        <MessageStrip text="{i18n>request.rulesLater}" type="Information" showIcon="true"/>
      </VBox>
    </content>
    <buttons>
      <Button text="{i18n>request.submit}" type="Emphasized" press=".onSaveRequest">
        <customData><core:CustomData key="submit" value="true"/></customData>
      </Button>
      <Button text="{i18n>request.saveDraft}" press=".onSaveRequest">
        <customData><core:CustomData key="submit" value="false"/></customData>
      </Button>
      <Button text="{i18n>common.cancel}" press=".onCloseRequestDialog"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
