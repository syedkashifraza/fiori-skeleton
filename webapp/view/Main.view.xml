<mvc:View
  controllerName="com.demo.fioriskeleton.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page id="page" title="{i18n>title}">
    <content>
      <VBox class="sapUiMediumMargin">
        <Title text="{i18n>welcome}" level="H2"/>
        <Text text="{i18n>description}" class="sapUiSmallMarginTop"/>
        <Button text="{i18n>buttonText}" type="Emphasized"
                press=".onPress" class="sapUiSmallMarginTop"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
