<mvc:View
  controllerName="com.team.leavetracker.controller.MyLeaves"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page id="myLeavesPage" title="{i18n>myLeaves.title}">
    <content>
      <VBox class="sapUiSmallMargin">
        <!-- Allowance for the current year -->
        <Panel headerText="{i18n>myLeaves.balanceHeader} {ml>/year}" class="sapUiNoContentPadding">
          <HBox wrap="Wrap" class="sapUiSmallMargin">
            <VBox class="sapUiMediumMarginEnd">
              <Label text="{i18n>myLeaves.allowance}"/>
              <ObjectNumber number="{ml>/allowance}" unit="{i18n>leave.days}" emphasized="false"/>
            </VBox>
            <VBox class="sapUiMediumMarginEnd">
              <Label text="{i18n>myLeaves.used}"/>
              <ObjectNumber number="{ml>/used}" unit="{i18n>leave.days}" emphasized="false"/>
            </VBox>
            <VBox class="sapUiMediumMarginEnd">
              <Label text="{i18n>myLeaves.planned}"/>
              <ObjectNumber number="{ml>/planned}" unit="{i18n>leave.days}" emphasized="false" state="Information"/>
            </VBox>
            <VBox class="sapUiMediumMarginEnd">
              <Label text="{i18n>myLeaves.remaining}"/>
              <ObjectNumber number="{ml>/remaining}" unit="{i18n>leave.days}" state="{= ${ml>/remaining} &lt; 0 ? 'Error' : 'Success' }"/>
            </VBox>
            <VBox width="14rem" justifyContent="Center">
              <ProgressIndicator percentValue="{ml>/usedPercent}" displayValue="{ml>/usedText}" showValue="true" state="Information"/>
            </VBox>
          </HBox>
        </Panel>

        <Table
          id="myLeavesTable"
          class="sapUiSmallMarginTop"
          growing="true"
          growingThreshold="20"
          noDataText="{i18n>myLeaves.empty}"
          items="{
            path: '/LeaveRequests',
            suspended: true,
            sorter: { path: 'startDate', descending: true },
            parameters: { $count: true }
          }">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{i18n>myLeaves.requests} ({ml>/count})" level="H2"/>
              <ToolbarSpacer/>
              <SegmentedButton selectedKey="{ml>/filter}" selectionChange=".onFilterChange">
                <items>
                  <SegmentedButtonItem key="upcoming" text="{i18n>myLeaves.filterUpcoming}"/>
                  <SegmentedButtonItem key="past" text="{i18n>myLeaves.filterPast}"/>
                  <SegmentedButtonItem key="all" text="{i18n>myLeaves.filterAll}"/>
                </items>
              </SegmentedButton>
              <Button text="{i18n>myLeaves.new}" type="Emphasized" icon="sap-icon://add" press=".onNewRequest"/>
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column><Text text="{i18n>leave.type}"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>leave.period}"/></Column>
            <Column hAlign="End" width="7rem"><Text text="{i18n>leave.workingDays}"/></Column>
            <Column width="9rem"><Text text="{i18n>leave.status}"/></Column>
            <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>leave.comment}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onRowPress">
              <cells>
                <ObjectIdentifier title="{type/name}"
                  text="{parts: [{path: 'startHalfDay', targetType: 'any'}, {path: 'endHalfDay', targetType: 'any'}], formatter: '.formatter.halfDayInfo'}"/>
                <Text text="{parts: [{path: 'startDate', targetType: 'any'}, {path: 'endDate', targetType: 'any'}], formatter: '.formatter.dateRange'}"/>
                <ObjectNumber number="{workingDays}" unit="{i18n>leave.days}"/>
                <ObjectStatus
                  text="{path: 'status', formatter: '.formatter.statusText'}"
                  state="{path: 'status', formatter: '.formatter.statusState'}"
                  icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                <Text text="{comment}" maxLines="2"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
