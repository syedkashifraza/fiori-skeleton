{
  "name": "com.team.leavetracker",
  "version": "0.0.1",
  "private": true,
  "description": "Team Leave Tracker - SAPUI5 freestyle Fiori app",
  "scripts": {
    "start": "fiori run --config ./ui5-mock.yaml --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-manager": "fiori run --config ./ui5-mock.yaml --open \"index.html?sap-ui-xx-viewCache=false&role=manager\"",
    "start-flp": "fiori run --config ./ui5-mock.yaml --open \"test/flp.html?sap-ui-xx-viewCache=false#app-preview\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"index.html?sap-ui-xx-viewCache=false\"",
    "lint": "eslint .",
    "build": "ui5 build -a --clean-dest --include-task=generateCachebusterInfo"
  },
  "devDependencies": {
    "@sap-ux/eslint-plugin-fiori-tools": "^10.18.5",
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.4.19",
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^4.0.0",
    "eslint": "^10.15.0",
    "rimraf": "6.0.1",
    "typescript-eslint": "^8.74.0"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html"
}
